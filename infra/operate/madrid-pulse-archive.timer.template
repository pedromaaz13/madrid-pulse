# Temporizador systemd del archivo diario — MP-021.
# Equivalente Linux de `com.madridpulse.archive.plist.template`.
#
#   sudo cp madrid-pulse-archive.service madrid-pulse-archive.timer /etc/systemd/system/
#   sudo systemctl enable --now madrid-pulse-archive.timer
#   systemctl list-timers madrid-pulse-archive.timer

[Unit]
Description=Archivo diario del histórico de Madrid Pulse

[Timer]
# Hora local de Madrid, después del horizonte de horas extendidas `24:xx`.
OnCalendar=*-*-* 03:15:00
# Si el equipo estuvo apagado a esa hora, se ejecuta al arrancar: el archivo
# es idempotente por día, así que recuperar una ejecución perdida es seguro.
Persistent=true
Unit=madrid-pulse-archive.service

[Install]
WantedBy=timers.target
